{
  "model_settings": {
    "model_path": "models/DeepSeek-R1-Distilled-Llama-70B-Q4_K_M.gguf",
    "gpu_layers": -1,
    "context_window": 65536,
    "n_batch": 512,
    "offload_kqv": true,
    "max_tokens": 4096
  },
  "global_exclusions": {
    "directories": ["node_modules", ".git", "dist", "build", "target", "venv", ".venv", "__pycache__", ".pytest_cache", "htmlcov", "coverage"],
    "extensions": [".png", ".jpg", ".jpeg", ".gif", ".ico", ".pdf", ".mp4", ".lock", "-lock.json", ".woff", ".woff2", ".ttf", ".gguf", ".bin"],
    "max_file_bytes": 1000000
  },
  "analysis_passes": [
    "security",
    "memory",
    "algorithmic",
    "test_coverage"
  ],
  "execution": {
    "sequential": true,
    "skip_unchanged_commit": true,
    "compare_to_latest_real": true
  },
  "test_settings": {
    "enabled": true,
    "timeout_seconds": 600
  },
  "git": {
    "commit_name": "CodeGuard Auditor",
    "commit_email": "codeguard@localhost"
  },
  "repositories": [
    {
      "name": "core-api-service",
      "local_mirror_url": "ssh://git@192.168.1.50/srv/git/core-api-service.git",
      "branch": "main",
      "output_report_dir": "reports/codeguard"
    },
    {
      "name": "frontend-dashboard",
      "local_mirror_url": "ssh://git@192.168.1.50/srv/git/frontend-dashboard.git",
      "branch": "develop",
      "output_report_dir": "reports/codeguard"
    }
  ]
}
