.DS_Store

# Local runtime state — clones, weights, and generated reports stay on this
# machine. Audit runs never commit or push them.
workspace/*
!workspace/.gitkeep
models/*
!models/.gitkeep
reports/*
!reports/.gitkeep

testdata/**/.coverage*
testdata/**/.codeguard-coverage.json
testdata/**/.pytest_cache/
